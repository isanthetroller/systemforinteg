<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-Api-Key, X-Requested-With, Accept, Origin"
</IfModule>

# Handle HTTP OPTIONS pre-flight requests gracefully
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Set Default Index Page
DirectoryIndex index.html index.php

# Disable directory listing for security
Options -Indexes

# The host tells browsers to keep pages and scripts for 30 days, so a new deploy would not show up.
# Ask browsers to check for a newer copy every time (a quick 304 when nothing changed).
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|mp4)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# HTTPS hardening. Browsers ignore Strict-Transport-Security on plain http, so sending it everywhere is safe: once someone
# has opened the site over https their browser keeps using https. Plain-http visitors are sent to https by a script at
# the top of each page (a server redirect rule could loop behind this host's proxy, so none is used here).
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=15552000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
