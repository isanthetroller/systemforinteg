<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-Api-Key, X-Requested-With, Accept, Origin"
</IfModule>

RewriteEngine On

# Pass the Authorization (Bearer token) header through to PHP.
# Shared hosts running PHP as CGI/FastCGI (e.g. InfinityFree) otherwise drop it.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Handle HTTP OPTIONS pre-flight requests gracefully
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Disable directory listing for security
Options -Indexes
